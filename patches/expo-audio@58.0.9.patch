diff --git a/android/src/main/java/expo/modules/audio/service/MurmurLibrary.kt b/android/src/main/java/expo/modules/audio/service/MurmurLibrary.kt
new file mode 100644
index 0000000000000000000000000000000000000000..6b7ccfaed7c040b0264decc061c95cb1a3eeddcd
--- /dev/null
+++ b/android/src/main/java/expo/modules/audio/service/MurmurLibrary.kt
@@ -0,0 +1,106 @@
+package expo.modules.audio.service
+
+import android.content.Context
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import androidx.annotation.OptIn
+import androidx.media3.common.MediaItem
+import androidx.media3.common.MediaMetadata
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.session.MediaLibraryService
+import com.google.common.util.concurrent.ListenableFuture
+import com.google.common.util.concurrent.SettableFuture
+import java.util.UUID
+
+// Murmur patch: Android Auto's browse tree comes from JS. A browser asks for a folder's children,
+// JS answers with rows (title, subtitle, artwork file), and picking a playable row tells JS to
+// play it. The last answer for each folder is kept, so a folder still opens when JS is slow.
+@OptIn(UnstableApi::class)
+object MurmurLibrary {
+  const val ROOT_ID = "murmur-root"
+  const val EVENT_REQUEST = "libraryRequest"
+  const val EVENT_PLAY = "libraryPlay"
+  private const val ANSWER_TIMEOUT_MS = 4000L
+
+  /** Sends an event to JS; null while the JS side isn't running. */
+  @Volatile
+  var emit: ((String, Map<String, Any?>) -> Unit)? = null
+
+  /** The service's long-lived session, to tell browsers a folder changed. */
+  var session: MediaLibraryService.MediaLibrarySession? = null
+
+  private val main = Handler(Looper.getMainLooper())
+  private val pending = mutableMapOf<String, Pair<String, SettableFuture<List<MediaItem>>>>()
+  private val answers = mutableMapOf<String, List<MediaItem>>()
+
+  fun children(parentId: String): ListenableFuture<List<MediaItem>> {
+    val future = SettableFuture.create<List<MediaItem>>()
+    val send = emit
+    if (send == null) {
+      future.set(answers[parentId] ?: emptyList())
+      return future
+    }
+    val requestId = UUID.randomUUID().toString()
+    synchronized(pending) { pending[requestId] = parentId to future }
+    main.postDelayed({
+      val timedOut = synchronized(pending) { pending.remove(requestId) }
+      timedOut?.second?.set(answers[parentId] ?: emptyList())
+    }, ANSWER_TIMEOUT_MS)
+    send(EVENT_REQUEST, mapOf("requestId" to requestId, "parentId" to parentId))
+    return future
+  }
+
+  /** JS's rows for a request. Each is a map: id, title, subtitle, artwork (file URI), browsable, playable. */
+  fun answer(context: Context, requestId: String, rows: List<Map<String, Any?>>) {
+    val (parentId, future) = synchronized(pending) { pending.remove(requestId) } ?: return
+    val items = rows.mapNotNull { row -> toItem(context, row) }
+    answers[parentId] = items
+    future.set(items)
+  }
+
+  /** A row kept from an earlier answer, for browsers that look one up by id. */
+  fun item(mediaId: String): MediaItem? = answers.values.firstNotNullOfOrNull { list -> list.firstOrNull { it.mediaId == mediaId } }
+
+  /** Tells browsers to load a folder again (all of them when null), say after the Music tab is switched off. */
+  fun refresh(parentId: String?) {
+    main.post {
+      val s = session ?: return@post
+      val ids = if (parentId == null) answers.keys.toList() + ROOT_ID else listOf(parentId)
+      ids.distinct().forEach { id -> s.notifyChildrenChanged(id, Int.MAX_VALUE, null) }
+    }
+  }
+
+  /** A row was picked to play; false when JS isn't there to do it. */
+  fun play(mediaId: String): Boolean {
+    val send = emit ?: return false
+    send(EVENT_PLAY, mapOf("mediaId" to mediaId))
+    return true
+  }
+
+  private fun toItem(context: Context, row: Map<String, Any?>): MediaItem? {
+    val id = row["id"] as? String ?: return null
+    val browsable = row["browsable"] == true
+    val metadata = MediaMetadata.Builder()
+      .setTitle(row["title"] as? String)
+      .setArtist(row["subtitle"] as? String)
+      .setSubtitle(row["subtitle"] as? String)
+      .setIsBrowsable(browsable)
+      .setIsPlayable(row["playable"] == true)
+      .setMediaType(if (browsable) MediaMetadata.MEDIA_TYPE_FOLDER_MIXED else MediaMetadata.MEDIA_TYPE_MUSIC)
+      .setArtworkUri((row["artwork"] as? String)?.let { ArtworkProvider.contentUri(context, it) })
+      .apply {
+        // A folder of albums or playlists reads better as a grid of covers.
+        if (row["grid"] == true) {
+          setExtras(
+            Bundle().apply {
+              putInt(AudioMediaSessionCallback.CONTENT_STYLE_BROWSABLE, AudioMediaSessionCallback.CONTENT_STYLE_GRID)
+              putInt(AudioMediaSessionCallback.CONTENT_STYLE_PLAYABLE, AudioMediaSessionCallback.CONTENT_STYLE_GRID)
+            }
+          )
+        }
+      }
+      .build()
+    return MediaItem.Builder().setMediaId(id).setMediaMetadata(metadata).build()
+  }
+}
