+  private void setDiscovery(final int flags, final Promise promise) {
+    final ReactApplicationContext context = getReactApplicationContext();
+    context.runOnUiQueueThread(new Runnable() {
+      @Override
+      public void run() {
+        CastContext castContext = RNGCCastContext.getSharedInstance(context);
+        if (castContext != null) {
+          // Adding the same callback again replaces its flags.
+          MediaRouter.getInstance(context).addCallback(castContext.getMergedSelector(), mediaRouterCallback, flags);
+          mListenersAttached = true;
+        }
+        promise.resolve(null);
+      }
+    });
