# Local `pnpm dev`: keep the database, covers and downloads in the repo's git-ignored data/
# folder, and use the test audiobooks in data/audiobooks as the library.
DATA_DIR=../../data
LIBRARY_DIR=../../data/audiobooks
EPISODE_CACHE_DIR=../../data/cache
MUSIC_DIR=../../data/music
MOVIES_DIR=../../data/videos/movies
SHOWS_DIR=../../data/videos/shows
LOG_LEVEL=debug
