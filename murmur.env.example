# Keys and secrets for docker-compose.yml. Copy this file to murmur.env beside it, fill in what you
# use, and leave the rest commented out. Everything here is optional.

# Movies and shows: posters, descriptions and episode names. Free v3 key from
# https://www.themoviedb.org/settings/api
# TMDB_API_KEY=

# Match searches Google Books too. A free key keeps it off Google's small shared quota.
# GOOGLE_BOOKS_API_KEY=

# Turns on the add-ons (ad detection, movies and shows); Murmur and the add-ons read the same one.
# At least 32 characters: make one with `openssl rand -hex 32`. A shorter one keeps the add-ons off,
# and the add-ons refuse to start with it.
# ADDON_SECRET=

# The ad detection add-on: a Gemini key from https://aistudio.google.com, and optionally a Groq key
# for much better transcripts.
# GEMINI_API_KEY=
# GROQ_API_KEY=
